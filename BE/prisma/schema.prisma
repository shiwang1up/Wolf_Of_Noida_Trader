generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Candle {
  id        Int      @id @default(autoincrement())
  symbol    String   // e.g., "BTC-USDT"
  timeframe String   // e.g., "1m", "5m", "1h"
  timestamp DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  
  createdAt DateTime @default(now())

  @@unique([symbol, timeframe, timestamp]) // Prevent duplicate candle entries
}

model TestCandle {
  id        Int      @id @default(autoincrement())
  symbol    String
  timeframe String
  timestamp DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  
  createdAt DateTime @default(now())

  @@unique([symbol, timeframe, timestamp])
}

model Market {
  id         Int      @id @default(autoincrement())
  symbol     String   @unique // Internal symbol, e.g., "BTCUSDT"
  pair       String   @unique // Used in candle API, e.g., "B-BTC_USDT"
  baseCoin   String   // e.g., "BTC"
  quoteCoin  String   // e.g., "USDT"
  status     String   // e.g., "active"
  isTracking Boolean  @default(false) // Allows user to select specific coins to generate signals for
  
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
}

model Sentiment {
  id          Int      @id @default(autoincrement())
  source      String   // e.g., "CryptoPanic", "FearGreedIndex", "Twitter"
  score       Float    // Normalized score, e.g., -1.0 to 1.0 or 0 to 100
  label       String?  // e.g., "Bullish", "Bearish", "Neutral"
  metadata    Json?    // Store raw API text/response if needed
  timestamp   DateTime
  
  createdAt   DateTime @default(now())
}

model Signal {
  id              Int      @id @default(autoincrement())
  symbol          String
  baseCoin        String?  // e.g. "BTC"
  pair            String?  // e.g. "I-BTC_INR"
  action          String   // "BUY", "SELL", "HOLD"
  confidenceScore Float    // 0.0 to 10.0
  riskLevel       String   // "LOW", "MEDIUM", "HIGH"
  
  // Structured AI Response Fields
  summary         String?  // 1-sentence summary from AI
  primaryDriver   String?  // e.g. "LIQUIDITY & ORDERBOOK (35%)"
  riskWarning     String?  // e.g. "Low Volume or Potential Spoofing"
  trend           String?  // "bullish" | "bearish" | "ranging"
  momentum        String?  // "strengthening" | "weakening" | "neutral"
  sentiment       String?  // "fear" | "greed" | "neutral" etc.
  reasoning       String?  // Bullet-point reasoning from AI (joined array)
  
  timestamp       DateTime
  
  // Capturing the market state at the time of the signal
  currentPrice    Float
  
  createdAt       DateTime @default(now())
}

model News {
  id          Int      @id @default(autoincrement())
  source      String   // e.g., "CryptoPanic"
  headlines   Json     // Array of headline strings
  timestamp   DateTime // Time fetched
  createdAt   DateTime @default(now())
}
model OrderbookSnapshot {
  id        Int      @id @default(autoincrement())
  symbol    String
  asks      Json     // Object where keys are prices and values are volumes
  bids      Json
  timestamp DateTime
  createdAt DateTime @default(now())

  @@index([symbol, timestamp])
}

model LiquidityZone {
  id        Int      @id @default(autoincrement())
  symbol    String
  type      String   // "wall", "spoofing", "moving"
  side      String   // "bid", "ask"
  price     Float
  volume    Float
  strength  Float    // Score based on persistence/weight
  timestamp DateTime
  createdAt DateTime @default(now())
}
